# Entornos virtuales
env/
venv/
.venv/

# Bytecode de Python
__pycache__/
*.py[cod]
*$py.class

# Logs: el enunciado pide subir logs/ con el session_log de cada equipo.
# Netmiko no escribe las contrasenas en el session_log. Se excluyen solo
# logs temporales o de pruebas con datos sensibles:
logs/*.tmp
logs/privado_*

# Archivos locales / editor
.env
*.bak
.vscode/
.idea/
.DS_Store

# GNS3 (no forma parte de la entrega del script)
*.gns3
*.gns3a
project-files/
